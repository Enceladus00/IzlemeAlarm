# Rendered by the nginx image at start-up (envsubst on the environment:
# PORT, API_UPSTREAM, and NGINX_LOCAL_RESOLVERS from the container's resolv.conf).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Same-origin API: /api/* is forwarded to FastAPI without the /api prefix,
    # so the backend needs no CORS configuration.
    location /api/ {
        # A variable makes nginx re-resolve the name at run time; a load
        # balancer's IPs change, and a literal would be resolved only at start-up.
        # A variable also stops proxy_pass replacing the prefix, hence the rewrite.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        # Only used when API_UPSTREAM is https: the API behind a shared load
        # balancer needs SNI, and tokens must only go to a verified certificate.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # CSV uploads are limited to 5 MB by the API; allow multipart overhead.
        client_max_body_size 6m;
        proxy_read_timeout 120s;
    }

    # Hashed build assets never change.
    # (add_header in a location replaces the server-level headers, so repeat them.)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve index.html; never cache it.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
