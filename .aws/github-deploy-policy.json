{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:eu-north-1:299362456172:repository/izlemealarm-backend",
        "arn:aws:ecr:eu-north-1:299362456172:repository/izlemealarm-frontend"
      ]
    },
    {
      "Sid": "DeployExpressService",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:UpdateExpressGatewayService",
        "ecs:DescribeExpressGatewayService",
        "ecs:DescribeClusters",
        "ecs:DescribeServices",
        "ecs:ListServiceDeployments",
        "ecs:DescribeServiceDeployments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadDatabaseUrlForMigrations",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-north-1:299362456172:parameter/izlemealarm-backend/DATABASE_URL"
    },
    {
      "Sid": "PassOnlyTheServiceRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::299362456172:role/service-role/ecsTaskExecutionRole",
        "arn:aws:iam::299362456172:role/service-role/ecsInfrastructureRoleForExpressServices"
      ]
    }
  ]
}
