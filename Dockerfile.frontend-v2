FROM node:22-alpine AS build
WORKDIR /app
COPY frontend-v2/package.json frontend-v2/package-lock.json ./
RUN npm ci
COPY frontend-v2/ ./
RUN npm run build

FROM nginx:1.27-alpine
# API_UPSTREAM: where /api/* is proxied (the FastAPI service). PORT: listen port.
ENV PORT=8080 \
    API_UPSTREAM=http://backend:8000
COPY frontend-v2/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
