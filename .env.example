# Replace USER and PASSWORD with your local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/izleme_alarm

# JWT signing key; replace with a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Proves to the API that a client address came from the frontend's nginx.
# Only needed behind nginx; use the same long random value on both.
PROXY_SHARED_SECRET=

# Streamlit frontend API base URL
API_BASE_URL=http://127.0.0.1:8000
ENABLE_DEMO_ENDPOINTS=false